# OpenRouter API key - get one at https://openrouter.ai/keys
# Required: the server will refuse to start without it.
OPENROUTER_API_KEY=

# Model id to use for movie recommendations.
# Optional - defaults to minimax/minimax-m3:free
# Free model ids rotate; list current ones with:
#   curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
AI_MODEL=minimax/minimax-m3:free

# Public URL of the frontend, sent to OpenRouter as the HTTP-Referer
# attribution header. Optional.
APP_URL=https://netflix-gptstream.vercel.app

# Port for the API server. Optional - defaults to 3000.
PORT=3000
